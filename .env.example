# ─── Database (Neon Postgres) ─────────────────────────────────────────
# Get from https://console.neon.tech after creating a project.
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ─── App URL ──────────────────────────────────────────────────────────
# In dev: http://localhost:3000
# In prod: your deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (Clerk) ─────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Email (optional) ─────────────────────────────────────────────────
# Only required if lib/email/send.ts is wired up; falls back to console.log
# when unset.
RESEND_API_KEY=
