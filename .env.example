# ─── Database (Neon Postgres) ─────────────────────────────────────────
# Get from https://console.neon.tech after creating a project.
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ─── App URL ──────────────────────────────────────────────────────────
# In dev: http://localhost:3000
# In prod: your deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (Better Auth) ───────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin of the app (used for auth callbacks). e.g. https://your-domain
BETTER_AUTH_URL=

# ─── Email (optional) ─────────────────────────────────────────────────
# Only required if lib/email/send.ts is wired up; falls back to console.log
# when unset.
RESEND_API_KEY=
